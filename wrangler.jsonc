// Cloudflare Worker "grits" — serves the React app (apps/web/dist) and the API (/api/*).
// Connected to github.com/amanorsac/GRITS via Workers Builds: every push to main deploys.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grits",
  "main": "apps/web/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build -w web"
  },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Keep variables set in the dashboard (e.g. Supabase keys) when a git push redeploys.
  "keep_vars": true,
  // Daily at 03:00 GMT — keeps the free Supabase project from pausing.
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    // Only values that must never change live here — anything listed in this file overwrites the
    // dashboard on every git deploy.
    "SUPABASE_URL": "https://ckwzixmsyfgonqiayltb.supabase.co",
    "MEMBER_EMAIL_DOMAIN": "members.gritandgrace.app"
  }
  // Editable in the dashboard (Settings → Variables, plain text), with defaults in worker/index.ts:
  //   APP_ORIGIN (default: the URL the request came in on), SAFEGUARDING_EMAIL, EMAIL_FROM,
  //   BUNNY_LIBRARY_ID, JAAS_APP_ID, JAAS_KEY_ID.
  // Secrets — set with `npx wrangler secret put <NAME>` or in the dashboard (Settings → Variables):
  //   SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, PAYSTACK_SECRET_KEY, OPENAI_API_KEY,
  //   BUNNY_TOKEN_KEY, BUNNY_API_KEY, JAAS_PRIVATE_KEY, RESEND_API_KEY
}
